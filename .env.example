# LLM: use mock for offline development, real for Gemini.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# RAG and SQLite paths.
USE_MOCK_RAG=true
CHROMA_DIR=.chroma
DB_PATH=data/app.db

# Email: file writes to outbox/; smtp sends a real message.
EMAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Used only by pytest -m integration.
SMTP_TEST_TO=

# Gmail requires 2-Step Verification and an App Password. Mailtrap is a safe SMTP alternative.
